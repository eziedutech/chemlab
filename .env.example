# Backend: LLM provider settings.
# Any provider exposing an OpenAI compatible POST /v1/chat/completions endpoint works.
# Switching provider is an environment change only, no code change required.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-with-your-provider-key

# Backend: comma separated origins allowed to call the API.
# Empty means permissive, which is acceptable for local development only.
# In production: https://chemlab.eziedutech.dev
ALLOWED_ORIGINS=

# Frontend: base URL of the Rust backend, read at runtime through
# /runtime-config, so changing it is a restart rather than a rebuild.
# In production: https://apichemlab.eziedutech.dev
API_BASE_URL=http://localhost:8080

# The same value compiled into the bundle, used only if /runtime-config cannot
# be reached. Changing this one does require rebuilding the frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
